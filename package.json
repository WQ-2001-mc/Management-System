{
  "name": "nexus-enterprise-management",
  "version": "1.0.0",
  "private": true,
  "description": "新颖、专业的一体化企业数据管理平台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:push": "tsx scripts/ensure-sqlite.ts && prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.90.0",
    "antd": "^6.4.5",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^27.2.0",
    "postcss": "8.5.10",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite-tsconfig-paths": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
